  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'Rules

    1. Wires can only connect straight down or one column over.

    2.
    Purple and orange wires cross no more than two times.

    3. Blue and green
    wires cross no more than once.

    4, Wires can be disconnected by double clicking.'
  m_isRightToLeft: 0
